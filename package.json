{
  "name": "terabot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @terabot/db generate",
    "db:migrate": "pnpm --filter @terabot/db migrate",
    "db:seed": "pnpm --filter @terabot/db seed",
    "catalog:sync": "pnpm --filter @terabot/worker catalog:sync",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
