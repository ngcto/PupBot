# ─────────────────────────────────────────────────────────────────────────────
# Terabot environment. Copy to .env (git-ignored) and fill in.
# Every credential belongs here, never in code.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres 17. `pnpm db:up` starts the one in docker-compose.yml.
DATABASE_URL=postgres://terabot:terabot@localhost:5432/terabot

# better-auth. Generate with: openssl rand -base64 32
# Leave empty until you paste that value: the config rejects anything under 32
# characters, so a copied placeholder must never pass validation.
BETTER_AUTH_SECRET=
# Public origin the web app is served from (cookie + callback base).
BETTER_AUTH_URL=http://localhost:3000

# API (Hono) — server-side origin and the browser-visible origin.
API_URL=http://localhost:8787
NEXT_PUBLIC_API_URL=http://localhost:8787
API_PORT=8787

# Where a run executes. `queue` hands it to the pg-boss worker; `inline` runs it
# in the request that started it — what a serverless deployment needs, because
# there is no long-lived worker process. See docs/deploy.md.
RUN_MODE=queue

# Postgres pool ceiling per process. A serverless function needs this small:
# one Fluid instance per concurrent request, and Supabase's free tier caps
# total connections.
DATABASE_POOL_MAX=10

# Mobile app (apps/mobile). The API origin a *phone* can reach: use your
# machine's LAN address, e.g. http://192.168.1.20:8787 — localhost is the phone.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Dev-only OpenAI-compatible stub endpoint so chat works with no API key.
# Lives at ${API_URL}/dev/stub/v1. Never enabled when NODE_ENV=production.
STUB_PROVIDER=true

# 32-byte base64 key that encrypts provider keys at rest (model endpoints,
# computer accounts). Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# S3-compatible storage for attachments. Empty means the bytes live in Postgres
# (`attachment_blob`), which needs no second credential. Supabase Storage speaks
# S3 at https://<project>.supabase.co/storage/v1/s3 — endpoint, bucket and the
# bucket's S3 access keys go here.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Vercel AI Gateway: an OpenAI-compatible default endpoint for new workspaces.
# On a Vercel deployment no key is needed — VERCEL_OIDC_TOKEN (injected by the
# platform) authenticates each request. Elsewhere, set AI_GATEWAY_API_KEY:
# https://vercel.com/dashboard → AI Gateway → API keys.
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=recursive/flint-v1.0
AI_GATEWAY_API_KEY=

# Computer providers. Instabox: https://instabox.dev → Dashboard → API keys.
INSTABOX_API_KEY=
# Boxes the Instabox account's plan allows at once (free is 1; grandfathered free accounts 5).
INSTABOX_CAPACITY=1
# Boat: https://boat.dev → Dashboard → API keys (paid plan).
BOAT_API_KEY=

# Composio (apps marketplace): https://app.composio.dev → Settings → API keys.
COMPOSIO_API_KEY=

# Optional default model endpoints. Users normally add their own in Settings › Models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# models.dev catalogue snapshot used to match context window + pricing.
MODELS_DEV_URL=https://models.dev/api.json

# Postgres over TLS: node-postgres 8.23 treats `sslmode=require` as verify-full,
# and Supabase's pooler chain is not in the default trust store, so a hosted
# DATABASE_URL ends with `?sslmode=no-verify` (still encrypted, chain unverified).

# ─────────────────────────────────────────────────────────────────────────────
# Marketing site (apps/marketing). Public values only; no secrets.
# ─────────────────────────────────────────────────────────────────────────────
# Canonical origin of the marketing site, used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# The product's origin. The site's "Sign in" and "Create an account" links go here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
