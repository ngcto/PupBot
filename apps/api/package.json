{
  "name": "@pupbot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@pupbot/agent": "workspace:*",
    "@pupbot/computers": "workspace:*",
    "@pupbot/config": "workspace:*",
    "@pupbot/db": "workspace:*",
    "@pupbot/providers": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg-boss": "^12.38.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  }
}
