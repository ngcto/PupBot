{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_URL",
    "API_PORT",
    "RUN_MODE",
    "DATABASE_POOL_MAX",
    "STUB_PROVIDER",
    "CREDENTIAL_ENCRYPTION_KEY",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "INSTABOX_API_KEY",
    "BOAT_API_KEY",
    "COMPOSIO_API_KEY",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "MODELS_DEV_URL",
    "AI_GATEWAY_BASE_URL",
    "AI_GATEWAY_MODEL",
    "AI_GATEWAY_API_KEY",
    "VERCEL",
    "VERCEL_OIDC_TOKEN",
    "NEXT_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "lint": {}
  }
}
