{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "MIGRATE_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_URL",
    "API_PORT",
    "NEXT_PUBLIC_API_URL",
    "RUN_MODE",
    "DATABASE_POOL_MAX",
    "STUB_PROVIDER",
    "CREDENTIAL_ENCRYPTION_KEY",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "INSTABOX_API_KEY",
    "INSTABOX_CAPACITY",
    "BOAT_API_KEY",
    "CAPTCHA_SOLVER_PROVIDER",
    "CAPTCHA_SOLVER_API_KEY",
    "CAPTCHA_SOLVER_BASE_URL",
    "AGENT37_API_KEY",
    "AGENT37_CAPACITY",
    "AGENT37_TEMPLATE",

    "COMPOSIO_API_KEY",
    "COMPOSIO_PROJECT_API_KEY",
    "COMPOSIO_BASE_URL",
    "OPENAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "MODELS_DEV_URL",
    "AI_GATEWAY_BASE_URL",
    "AI_GATEWAY_MODEL",
    "AI_GATEWAY_API_KEY",
    "VERCEL",
    "VERCEL_OIDC_TOKEN",
    "EXPO_PUBLIC_API_URL",
    "CI",
    "PLAYWRIGHT_BROWSERS_PATH",
    "OWNER_EMAILS",
    "POLAR_ACCESS_TOKEN",
    "POLAR_WEBHOOK_SECRET",
    "POLAR_SERVER",
    "POLAR_PLANS"
  ],
  "globalDependencies": [
    "eslint.config.js",
    "tsconfig.base.json",
    ".nvmrc",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"] },
    "lint": {},
    "dev": { "cache": false, "persistent": true },
    "e2e": { "dependsOn": ["^build"], "cache": false }
  }
}
